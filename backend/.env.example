# Copy to backend/.env for local development. Never commit the real file.

DEBUG=True
SECRET_KEY=dev-only-insecure-key-change-me

# Leave unset to use SQLite in backend/db.sqlite3
# DATABASE_URL=postgres://escaque:escaque@localhost:5432/escaque

ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 127.0.0.1 when the engine container publishes its port locally;
# "stockfish" inside docker compose.
STOCKFISH_HOST=127.0.0.1
STOCKFISH_PORT=23249
STOCKFISH_DEFAULT_MOVETIME=500
STOCKFISH_MAX_MOVETIME=5000
